# Скопируйте в .env и заполните.

# Токен Hugging Face. Обязателен: нужен и для VAD внутри GigaAM, и для диаризации.
# Перед первым запуском примите условия ОБЕИХ моделей на huggingface.co,
# иначе скачивание вернёт 403:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Модель GigaAM. Только v3_e2e_* дают пунктуацию и нормализацию текста.
# Варианты: v3_e2e_rnnt (точнее), v3_e2e_ctc (быстрее), v2_rnnt, v2_ctc
GIGAAM_MODEL=v3_e2e_rnnt

# cpu | mps  (cuda на Mac недоступна). На mps и распознавание, и диаризация
# в 7–10 раз быстрее, результат побайтно совпадает с cpu.
ASR_DEVICE=mps
DIARIZE_DEVICE=mps

# Разделение по говорящим. Выключите, если нужен только сплошной текст.
# На mps стадия занимает около 10% длительности записи.
DIARIZATION_ENABLED=true

# Число говорящих. Пусто — pyannote решает сам. NUM_SPEAKERS задаёт точное
# число и перекрывает границы. Если модель упорно склеивает собеседников
# в одного, начните с MIN_SPEAKERS=2.
NUM_SPEAKERS=
MIN_SPEAKERS=
MAX_SPEAKERS=

# pyannote.audio 4.x по умолчанию отправляет длительность записи и число
# говорящих на otel.pyannote.ai. Здесь это выключено — включайте осознанно.
DIARIZATION_TELEMETRY=false
